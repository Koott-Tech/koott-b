# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
TIMEZONE=Asia/Kolkata

# Comma-separated list of allowed browser origins (CORS + CSRF).
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CLIENT_SITE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# ─── Supabase (NEW project — do not point at the Wix-era production DB) ──────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
REQUEST_SIGNING_SECRET=

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
RAZORPAY_USE_PRODUCTION=false
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_PROD_KEY_ID=
RAZORPAY_PROD_KEY_SECRET=
RAZORPAY_SUCCESS_URL=http://localhost:3000/payment/success
RAZORPAY_FAILURE_URL=http://localhost:3000/payment/failure

# ─── Payments (PayU — optional, only if the PayU path is enabled) ────────────
PAYU_TEST_MERCHANT_ID=
PAYU_TEST_SALT=
PAYU_PROD_MERCHANT_ID=
PAYU_PROD_SALT=
PAYU_SUCCESS_URL=
PAYU_FAILURE_URL=

# ─── Google Calendar / Meet ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/oauth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/api/oauth/google/callback
FRONTEND_GOOGLE_CLIENT_ID=
# Service-account JSON as a single line, OR place google-service-account.json at the repo root.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Koott
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── WhatsApp (Interakt and/or Gupshup) ──────────────────────────────────────
INTERAKT_API_KEY=
INTERAKT_TPL_BOOKING_CONFIRMATION=
INTERAKT_TPL_RESCHEDULED=
INTERAKT_TPL_SESSION_REMINDER=
INTERAKT_TPL_SESSION_NOTIFICATION=
INTERAKT_TPL_SESSION_FOLLOW_UP=
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE=

# ─── Ops / alerting ──────────────────────────────────────────────────────────
ADMIN_EMAIL=
COMPANY_ADMIN_EMAIL=
CRAWLER_ALERT_RECIPIENTS=
OVERBOOKING_ALERT_EMAIL=
OPERATIONS_WHATSAPP_NUMBER=
FREE_ASSESSMENT_PSYCHOLOGIST_EMAIL=assessment.koott@gmail.com
ASSESSMENT_PSYCHOLOGIST_ID=

# ─── Tuning (safe defaults; override only if needed) ─────────────────────────
CALENDAR_SYNC_DAYS=30
CALENDAR_SYNC_INTERVAL_MINUTES=15
SECURITY_LOG_RETENTION_DAYS=90
ENABLE_DEBUG_ROUTES=false

# TEMPORARY — see utils/phoneVerification.js. Reserved numbers that bypass the
# WhatsApp code, for testing the booking flow. Leave empty in production.
PHONE_OTP_TEST_NUMBERS=
PHONE_OTP_TEST_CODE=1234
